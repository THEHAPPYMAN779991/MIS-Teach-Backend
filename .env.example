# Copy this file to api.env for local development. Do not commit api.env.
# PowerShell: Copy-Item .env.example api.env

# AI provider: vertex, aistudio, ollama, or leave blank to retain caller defaults.
AI_PROVIDER=
GEMINI_BACKEND=

# Vertex AI (required only when GEMINI_BACKEND=vertex or AI_PROVIDER=vertex)
VERTEX_PROJECT=
VERTEX_LOCATION=
# Supported by the Gemini backend fallback when supplied by the environment.
GOOGLE_CLOUD_PROJECT=

# Google AI Studio. Configure one single key OR one or more comma-separated
# key groups. The multi-agent key manager reads variables ending in _API_KEYS.
GEMINI_API_KEY=
GEMINI_API_KEYS=
WU_API_KEYS=
PAN_API_KEYS=
AI_API_KEYS=
GENAI_API_KEY=
GOOGLE_API_KEY=
DEFAULT_API_GROUP=

# Flask / mail configuration. FLASK_SECRET_KEY is required when no ignored
# local security_key file is present.
FLASK_SECRET_KEY=
# Legacy alias accepted by config.py. Prefer FLASK_SECRET_KEY for new setups.
SECRET_KEY=
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_DEFAULT_SENDER=
LINE_CHANNEL_ACCESS_TOKEN=
LINE_CHANNEL_SECRET=

# Application data services
MONGO_URI=
# Optional: only for tool/run_gold_rag_retrieval_experiment.py when it uses a
# different MongoDB instance than the application.
RAG_EXPERIMENT_MONGO_URI=
MONGO_DB_NAME=
NEO4J_URI=
NEO4J_USERNAME=
NEO4J_PASSWORD=
NEO4J_DATABASE=
REDIS_URL=
SQLALCHEMY_DATABASE_URI=
SQLALCHEMY_DATABASE_URI_PRODUCTION=

# RAG and GraphRAG service endpoints
RAG_BACKEND=
CHROMADB_COLLECTION=
GRAPHRAG_API_BASE=
GRAPHRAG_DEFAULT_TIMEOUT=
GRAPHRAG_QUERY_TIMEOUT=
GRAPHRAG_TRACE_MAX_TEXT=
OLLAMA_BASE_URL=
# Required only when serving images generated by the separate PDF-question pipeline.
PDF_OUTPUT_JSON_DIR=
PDF_TEST_IMAGE_DIR=
PDF_TEMP_ASSETS_DIR=
PDF_ASSETS_DIR=
MIS_DEFAULT_QUESTION_SOURCE=

# Optional question-to-concept mapping controls.
QUESTION_CONCEPT_TOP_K=
QUESTION_CONCEPT_MAX_CONCEPTS=
QUESTION_CONCEPT_MIN_SCORE=
QUESTION_CONCEPT_SCORE_WINDOW=
QUESTION_CONCEPT_TIMEOUT=

# Optional GraphRAG retrieval and prompt-budget overrides. Leave these
# commented out unless you intentionally want to override code defaults.
# GRAPHRAG_TOP_K=
# GRAPHRAG_CONTEXT_CHAR_BUDGET=
# GRAPHRAG_TEXT_ITEM_MAX_CHARS=
# GRAPHRAG_CHUNK_RERANK_ENABLED=
# GRAPHRAG_FILTER_NOISE_SECTIONS=
# GRAPHRAG_CHUNK_RERANK_MIN_SCORE=
# GRAPHRAG_CHUNK_RERANK_SCORE_WINDOW=
# GRAPHRAG_MAX_INJECTED_PREREQ_CHUNKS=
# GRAPHRAG_PREREQUISITE_FIRST=
# GRAPHRAG_MIN_CORE_CHUNKS=
# GRAPHRAG_PREREQUISITE_SCORE_BONUS=
# GRAPHRAG_TUTORING_MODE=
# GRAPHRAG_RERANK_WINDOW_CHARS=
# GRAPHRAG_RERANK_WINDOW_OVERLAP=
# GRAPHRAG_RERANK_MAX_WINDOWS=
